# ─────────────────────────────────────────────
#  Nexaro Tech — Environment Variables
#  Copy to .env.local and fill in. All optional:
#  the site builds and runs fine with none of them.
# ─────────────────────────────────────────────

# Canonical site URL — used by metadata, robots.txt, sitemap.xml
# (falls back to http://localhost:3000 when unset)
NEXT_PUBLIC_SITE_URL=

# ── Supabase (optional — enables contact-form persistence) ──
# Server inserts use the service-role key; it is server-only
# and must NEVER be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional anon key for future browser features (safe only with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Admin dashboard (optional — gates /admin/inquiries) ──
# Password for the admin sign-in page. Leave empty or set to YOUR_*
# to keep the dashboard locked.
ADMIN_PASS=
# HMAC secret for session cookies. Optional — when unset, a stable
# secret is derived from ADMIN_PASS.
ADMIN_SESSION_SECRET=
